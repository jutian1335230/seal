# Folder that holds the database and PDFs. Point this at a persistent disk when you deploy.
SEAL_DATA=data

# Public URL used inside signing emails. The browser link still works if this is unset.
SEAL_BASE_URL=https://your-host.example

# Optional. When set, the file list asks for this key. Signing links never do.
SEAL_ACCESS_KEY=

# Optional. When set, the agreement's text is sent to OpenAI on upload to name the parties
# and find the lines to sign. Leave unset to use the built-in rules only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. When SMTP_HOST is unset, copy the signing link instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
